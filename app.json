{
  "expo": {
    "name": "Letscalm",
    "slug": "DemoProject",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nandhu29.DemoProject"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nandhu29.DemoProject",
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "e5d56616-bc98-43a0-bd28-6d7a560a1a52"
      },
      "expo-updates": {
        "fallbackToCacheTimeout": 0
      }
    },
    "plugins": [
      "expo-video",
      "expo-secure-store"
    ]
  }
}
